# Copy to .env and fill in values:
#   cp .env.example .env
#
# Used by docker-compose.yml via ${VAR} substitution.

# Timezone (container clock / scheduled scans)
TZ=Europe/Amsterdam

# Radarr — optional; enables movie Search/Replace from the row context menu
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=your_radarr_api_key_here

# Sonarr — optional; enables TV SeasonSearch from the row context menu
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Comma-separated scan roots inside the container. When set, disables
# auto-discovery of top-level mounts. Paths must match your volume mounts.
# Example with the commented mounts in docker-compose.yml:
# SCAN_PATHS=/server1/movies,/server2/tv
SCAN_PATHS=

# Optional fallback version label if CHANGELOG.md cannot be parsed
# APP_VERSION=2.1.8
