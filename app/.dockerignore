# Keep build context small and avoid baking local data into the image.
results/
**/__pycache__/
**/*.py[cod]
**/*.log
**/*.db
**/*.db-*
.env
.env.*
!.env.example
.git
.gitignore
# Keep CHANGELOG.md (version badge); ignore other markdown in app/
*.md
!CHANGELOG.md
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
tests/
pytest.ini
requirements-dev.txt
_split_*.py
analyzer.py.monolith.bak
**/*.monolith.bak
